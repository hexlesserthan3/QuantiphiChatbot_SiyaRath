# Copy this file to .env. Never commit .env or real credentials.
PORT=3000
NODE_ENV=development

# Both MongoDB and an OpenAI API key are required.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=cadence_chat
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Set true only behind a trusted reverse proxy (for example, your hosting platform).
TRUST_PROXY=false
# Public origin, without a trailing slash. Optional for local development.
# APP_ORIGIN=https://your-app.example.com
